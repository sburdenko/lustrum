<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fi="using:FluentIcons.Avalonia"
        xmlns:md="clr-namespace:Markdown.Avalonia;assembly=Markdown.Avalonia"
        xmlns:vm="using:Lustrum.App.ViewModels"
        x:Class="Lustrum.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Lustrum"
        Width="1380" Height="860" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="Auto,2,*,Auto">

    <Grid Grid.Row="0" ColumnDefinitions="272,*,Auto" Margin="20,14,20,12">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource LxAccentBrush}">
          <fi:SymbolIcon Symbol="Library" IconVariant="Filled" FontSize="17" Foreground="White" />
        </Border>
        <StackPanel VerticalAlignment="Center" Spacing="0">
          <TextBlock Text="Lustrum" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="Claude Code skill inventory" FontSize="11" Classes="tertiary" />
        </StackPanel>
      </StackPanel>

      <TextBox x:Name="SearchBox" Grid.Column="1" Classes="search" MaxWidth="680" HorizontalAlignment="Stretch"
               Text="{Binding SearchText}"
               Watermark="Search name, description or tags">
        <TextBox.InnerLeftContent>
          <fi:SymbolIcon Symbol="Search" FontSize="16" Margin="12,0,4,0" Foreground="{DynamicResource LxTextTertiaryBrush}" />
        </TextBox.InnerLeftContent>
        <TextBox.InnerRightContent>
          <Button Command="{Binding ClearSearchCommand}" Background="Transparent" BorderThickness="0" Padding="8,4" Margin="0,0,6,0"
                  IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <fi:SymbolIcon Symbol="Dismiss" FontSize="14" />
          </Button>
        </TextBox.InnerRightContent>
      </TextBox>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
        <TextBlock Text="{Binding Summary}" Classes="secondary" VerticalAlignment="Center" />
        <Button Classes="ghost" Command="{Binding RescanCommand}" ToolTip.Tip="Rescan (F5)">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <fi:SymbolIcon Symbol="ArrowSync" FontSize="16" />
            <TextBlock Text="Rescan" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <ProgressBar Grid.Row="1" Height="2" IsIndeterminate="True" IsVisible="{Binding IsScanning}" Background="Transparent" />

    <Grid Grid.Row="2" ColumnDefinitions="272,8,*,8,460" Margin="14,4,14,10">

      <Border Classes="panel" Grid.Column="0">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto" Margin="16,12,10,4">
            <TextBlock Text="SOURCES" Classes="caption" VerticalAlignment="Center" />
            <CheckBox Grid.Column="1" IsChecked="{Binding ShowEmptySources}" MinWidth="0" Padding="6,0,0,0" FontSize="12"
                      Content="empty" ToolTip.Tip="Show projects without skills and missing projects" />
          </Grid>
          <TreeView Grid.Row="1" Classes="nav" ItemsSource="{Binding NavRoots}" SelectedItem="{Binding SelectedNode}">
            <TreeView.ItemTemplate>
              <TreeDataTemplate DataType="vm:NavNode" ItemsSource="{Binding Children}">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="2,0,6,0" ToolTip.Tip="{Binding Hint}">
                  <fi:SymbolIcon Symbol="{Binding Icon}" FontSize="16" Margin="0,0,10,0" Opacity="{Binding TitleOpacity}" />
                  <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" Opacity="{Binding TitleOpacity}" />
                  <TextBlock Grid.Column="2" Text="{Binding Count}" Classes="tertiary" FontSize="12"
                             VerticalAlignment="Center" IsVisible="{Binding HasCount}" />
                </Grid>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns" />

      <Border Classes="panel" Grid.Column="2">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto" Margin="18,14,14,8">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="{Binding ListTitle}" FontSize="15" FontWeight="SemiBold" />
              <TextBlock Text="{Binding VisibleSkills.Count}" Classes="tertiary" VerticalAlignment="Center" />
            </StackPanel>
            <ComboBox Grid.Column="1" Classes="quiet" ItemsSource="{Binding Sorts}" SelectedItem="{Binding SelectedSort}"
                      MinWidth="150" FontSize="12">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="vm:SortOption">
                  <TextBlock Text="{Binding Title}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>

          <ListBox Grid.Row="1" Classes="skills" ItemsSource="{Binding VisibleSkills}" SelectedItem="{Binding SelectedSkill}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:SkillItemViewModel">
                <Grid ColumnDefinitions="Auto,244,*,Auto,Auto" ColumnSpacing="10" Height="34">
                  <fi:SymbolIcon Symbol="{Binding KindIcon}" FontSize="16" Foreground="{DynamicResource LxAccentBrush}" />
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Prefix}" Foreground="{DynamicResource LxTextTertiaryBrush}" /><Run Text="{Binding Name}" FontWeight="SemiBold" />
                  </TextBlock>
                  <TextBlock Grid.Column="2" Text="{Binding Description}" Classes="secondary"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <Border Grid.Column="3" Classes="pill" MaxWidth="170">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <fi:SymbolIcon Symbol="{Binding SourceIcon}" />
                      <TextBlock Text="{Binding SourceLabel}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="4" Classes="pill" Width="26" Padding="0,3" IsVisible="{Binding ShowHealth}"
                          Classes.error="{Binding Health.IsError}" Classes.warning="{Binding Health.IsWarning}"
                          ToolTip.Tip="{Binding Health.Text}">
                    <StackPanel HorizontalAlignment="Center">
                      <fi:SymbolIcon Symbol="{Binding Health.Icon}" />
                    </StackPanel>
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                      IsVisible="{Binding IsEmptyResult}">
            <fi:SymbolIcon Symbol="SearchInfo" FontSize="34" Foreground="{DynamicResource LxTextTertiaryBrush}" />
            <TextBlock Text="Nothing found" Classes="secondary" HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="3" Background="Transparent" ResizeDirection="Columns" />

      <Border Classes="panel" Grid.Column="4">
        <Grid>
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" IsVisible="{Binding !HasCard}">
            <fi:SymbolIcon Symbol="Sparkle" FontSize="38" Foreground="{DynamicResource LxTextTertiaryBrush}" />
            <TextBlock Text="Select a skill in the list" Classes="secondary" HorizontalAlignment="Center" />
          </StackPanel>

          <Grid RowDefinitions="Auto,*" IsVisible="{Binding HasCard}">
            <StackPanel Margin="20,18,20,12" Spacing="12">
              <TextBlock Text="{Binding Card.Title}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
              <WrapPanel>
                <Border Classes="pill skill" Classes.command="{Binding Card.IsCommand}" Margin="0,0,6,6">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <fi:SymbolIcon Symbol="{Binding Card.KindIcon}" />
                    <TextBlock Text="{Binding Card.KindLabel}" />
                  </StackPanel>
                </Border>
                <Border Classes="pill" Margin="0,0,6,6">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <fi:SymbolIcon Symbol="{Binding Card.SourceIcon}" />
                    <TextBlock Text="{Binding Card.SourceLabel}" />
                  </StackPanel>
                </Border>
                <Border Classes="pill" Margin="0,0,6,6" Classes.ok="{Binding Card.Health.IsOk}"
                        Classes.warning="{Binding Card.Health.IsWarning}" Classes.error="{Binding Card.Health.IsError}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <fi:SymbolIcon Symbol="{Binding Card.Health.Icon}" />
                    <TextBlock Text="{Binding Card.Health.Text}" />
                  </StackPanel>
                </Border>
              </WrapPanel>
              <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding Card.Description}" TextWrapping="Wrap" LineHeight="20" Classes="secondary" Margin="0,0,10,0" />
              </ScrollViewer>
              <WrapPanel>
                <Button Classes="primary" Command="{Binding OpenFolderCommand}" Margin="0,0,8,8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <fi:SymbolIcon Symbol="FolderOpen" FontSize="16" />
                    <TextBlock Text="Show in folder" />
                  </StackPanel>
                </Button>
                <Button Classes="ghost" Command="{Binding CopyPathCommand}" Margin="0,0,8,8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <fi:SymbolIcon Symbol="Copy" FontSize="16" />
                    <TextBlock Text="Copy path" />
                  </StackPanel>
                </Button>
                <Button Classes="ghost" Command="{Binding CopyInvocationCommand}" Margin="0,0,0,8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <fi:SymbolIcon Symbol="SlashForward" FontSize="16" />
                    <TextBlock Text="Copy name" />
                  </StackPanel>
                </Button>
              </WrapPanel>
            </StackPanel>

            <TabControl Grid.Row="1" Classes="card" Padding="0">
              <TabItem Header="Overview">
                <ScrollViewer>
                  <StackPanel Margin="20,14,20,20" Spacing="20">

                    <StackPanel Spacing="8" IsVisible="{Binding Card.HasFrontmatter}">
                      <TextBlock Text="FRONTMATTER" Classes="caption" />
                      <Border Classes="panel" Background="{DynamicResource LxPanelAltBrush}" Padding="12,8">
                        <ItemsControl ItemsSource="{Binding Card.Frontmatter}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:FrontmatterEntry">
                              <Grid ColumnDefinitions="118,*" Margin="0,4">
                                <TextBlock Text="{Binding Key}" Classes="mono tertiary" VerticalAlignment="Top" />
                                <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"
                                                     FontFamily="{StaticResource LxMono}" FontSize="12" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Border>
                    </StackPanel>

                    <StackPanel Spacing="8">
                      <TextBlock Text="FILE" Classes="caption" />
                      <SelectableTextBlock Text="{Binding Card.FilePath}" TextWrapping="Wrap"
                                           FontFamily="{StaticResource LxMono}" FontSize="12" />
                      <TextBlock Classes="tertiary" FontSize="12">
                        <Run Text="{Binding Card.SizeText}" /><Run Text="  ·  modified " /><Run Text="{Binding Card.ModifiedText}" />
                      </TextBlock>
                    </StackPanel>

                    <StackPanel Spacing="8" IsVisible="{Binding Card.HasFiles}">
                      <TextBlock Text="SIBLING FILES" Classes="caption" />
                      <ItemsControl ItemsSource="{Binding Card.Files}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" Classes="mono secondary" Margin="0,2" TextTrimming="CharacterEllipsis" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="8" IsVisible="{Binding Card.HasConflicts}">
                      <TextBlock Text="NAME CONFLICTS" Classes="caption" />
                      <TextBlock Text="The same name also exists in:" Classes="secondary" />
                      <ItemsControl ItemsSource="{Binding Card.Conflicts}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:ConflictEntry">
                            <StackPanel Margin="0,4" Spacing="2">
                              <TextBlock Text="{Binding Source}" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding Path}" Classes="mono tertiary" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>

                  </StackPanel>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="Content">
                <Grid>
                  <md:MarkdownScrollViewer Markdown="{Binding Card.Body}" MarkdownStyleName="FluentTheme" Margin="12,6" />
                  <TextBlock Text="Loading…" Classes="tertiary" HorizontalAlignment="Center" VerticalAlignment="Center"
                             IsVisible="{Binding Card.IsBodyLoading}" />
                </Grid>
              </TabItem>
            </TabControl>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="3" Padding="20,6,20,10">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding StatusText}" Classes="tertiary" FontSize="12" />
        <TextBlock Grid.Column="1" Text="{Binding ScanError}" FontSize="12"
                   Foreground="{DynamicResource LxErrFgBrush}" />
      </Grid>
    </Border>

  </Grid>
</Window>
