<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fi="using:FluentIcons.Avalonia"
        xmlns:vm="using:Lustrum.App.ViewModels"
        xmlns:views="using:Lustrum.App.Views"
        x:Class="Lustrum.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Lustrum"
        Icon="/Assets/lustrum.png"
        Width="1380" Height="860" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="Auto,2,*,Auto">

    <Grid Grid.Row="0" ColumnDefinitions="272,*,Auto" Margin="20,14,20,12">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource LxAccentBrush}">
          <fi:SymbolIcon Symbol="Library" IconVariant="Filled" FontSize="17" Foreground="White" />
        </Border>
        <StackPanel VerticalAlignment="Center" Spacing="0">
          <TextBlock Text="Lustrum" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="Claude Code skill inventory" FontSize="11" Classes="tertiary" />
        </StackPanel>
      </StackPanel>

      <TextBox x:Name="SearchBox" Grid.Column="1" Classes="search" MaxWidth="680" HorizontalAlignment="Stretch"
               Text="{Binding SearchText}"
               Watermark="Search name, description or tags">
        <TextBox.InnerLeftContent>
          <fi:SymbolIcon Symbol="Search" FontSize="16" Margin="12,0,4,0" Foreground="{DynamicResource LxTextTertiaryBrush}" />
        </TextBox.InnerLeftContent>
        <TextBox.InnerRightContent>
          <Button Command="{Binding ClearSearchCommand}" Background="Transparent" BorderThickness="0" Padding="8,4" Margin="0,0,6,0"
                  IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <fi:SymbolIcon Symbol="Dismiss" FontSize="14" />
          </Button>
        </TextBox.InnerRightContent>
      </TextBox>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="16,0,0,0">
        <TextBlock Text="{Binding Summary}" Classes="secondary" VerticalAlignment="Center" Margin="0,0,4,0" />
        <Button x:Name="SettingsButton" Classes="ghost" ToolTip.Tip="Settings">
          <fi:SymbolIcon Symbol="Settings" FontSize="16" />
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <views:SettingsPanel />
            </Flyout>
          </Button.Flyout>
        </Button>
        <Button Classes="ghost" Command="{Binding CheckAllForUpdatesCommand}"
                ToolTip.Tip="Fetch every git repository that holds skills and show which skills have updates">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <fi:SymbolIcon Symbol="CloudSync" FontSize="16" />
            <TextBlock Text="Check for updates" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="ghost" Command="{Binding RescanCommand}" ToolTip.Tip="Rescan (F5)">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <fi:SymbolIcon Symbol="ArrowSync" FontSize="16" />
            <TextBlock Text="Rescan" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <ProgressBar Grid.Row="1" Height="2" IsIndeterminate="True" IsVisible="{Binding IsScanning}" Background="Transparent" />

    <Grid Grid.Row="2" ColumnDefinitions="272,8,*,8,460" Margin="14,4,14,10">
      <views:SourcesPane x:Name="Sources" Grid.Column="0" />
      <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns" />
      <views:SkillListPane x:Name="List" Grid.Column="2" />
      <GridSplitter Grid.Column="3" Background="Transparent" ResizeDirection="Columns" />
      <views:SkillCardPane x:Name="CardPane" Grid.Column="4" />
    </Grid>

    <Border Grid.Row="3" Padding="20,6,20,10">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
        <TextBlock Text="{Binding StatusText}" Classes="tertiary" FontSize="12" />
        <TextBlock Grid.Column="1" Text="{Binding WatchStatus}" Classes="tertiary" FontSize="12" Margin="16,0,0,0" />
        <TextBlock Grid.Column="2" Text="{Binding UsageStatus}" Classes="tertiary" FontSize="12" Margin="16,0,0,0" />
        <TextBlock Grid.Column="3" Text="{Binding UpdateStatus}" Classes="tertiary" FontSize="12" Margin="16,0,0,0" />
        <TextBlock Grid.Column="5" Text="{Binding ErrorMessage}" FontSize="12"
                   Foreground="{DynamicResource LxErrFgBrush}" TextTrimming="CharacterEllipsis" MaxWidth="640" />
      </Grid>
    </Border>

  </Grid>
</Window>
