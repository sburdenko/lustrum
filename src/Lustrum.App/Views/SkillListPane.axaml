<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lustrum.App.ViewModels"
             x:Class="Lustrum.App.Views.SkillListPane"
             x:DataType="vm:MainViewModel">
  <Border BorderBrush="{DynamicResource LxRuleBrush}" BorderThickness="0,0,1,0">
    <Grid RowDefinitions="Auto,*">
      <Border BorderBrush="{DynamicResource LxRuleBrush}" BorderThickness="0,0,0,1" Padding="16,10">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">
          <ItemsControl ItemsSource="{Binding Chips}" IsVisible="{Binding !IsProblemsView}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemSpacing="6" LineSpacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:ChipViewModel">
                <ToggleButton Classes="chip" Content="{Binding Label}" IsChecked="{Binding IsOn}"
                              IsEnabled="{Binding IsAvailable}" ToolTip.Tip="{Binding Hint}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding ProblemsTitle}" Classes="label" FontSize="13" VerticalAlignment="Center"
                     IsVisible="{Binding IsProblemsView}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" Margin="12,0,0,0"
                      IsVisible="{Binding !IsProblemsView}">
            <TextBlock Text="SORT" Classes="mono mute m" FontSize="11" VerticalAlignment="Center" />
            <ComboBox Classes="flat" ItemsSource="{Binding Sorts}" SelectedItem="{Binding SelectedSort}" MinWidth="118">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="vm:SortOption">
                  <TextBlock Text="{Binding Title}" Classes="mono" FontSize="11" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Budget.Text, FallbackValue=''}" IsVisible="{Binding HasBudget}"
                     Classes="mono b" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" Margin="230,0,0,0"
                     ToolTip.Tip="{Binding Budget.Tip, FallbackValue=''}" />
          <ListBox Grid.Row="1" Grid.ColumnSpan="2" Classes="segments" SelectionMode="AlwaysSelected"
                   ItemsSource="{Binding ProjectViews}" SelectedItem="{Binding SelectedProjectView}"
                   IsVisible="{Binding CanChooseProjectView}" HorizontalAlignment="Left">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:ProjectViewOption">
                <TextBlock Text="{Binding Title}" ToolTip.Tip="{Binding Hint}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <ListBox x:Name="SkillList" Grid.Row="1" Classes="rows" ItemsSource="{Binding ListRows}"
               SelectedItem="{Binding SelectedSkill}" IsVisible="{Binding !IsProblemsView}">
        <ListBox.Styles>
          <Style Selector="ListBoxItem" x:DataType="vm:IListRow">
            <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
          </Style>
        </ListBox.Styles>
        <ListBox.DataTemplates>
          <DataTemplate DataType="vm:ListHeader">
            <Border BorderBrush="{DynamicResource LxRuleBrush}" BorderThickness="0,0,0,1" Padding="16,16,16,6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Title}" FontFamily="{StaticResource LxSemiExtraBold}" FontSize="12"
                           LetterSpacing="1" Foreground="{DynamicResource LxInkBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding Count}" Classes="mono mute m" FontSize="11" />
              </Grid>
            </Border>
          </DataTemplate>
          <DataTemplate DataType="vm:SkillItemViewModel">
            <Border BorderBrush="{DynamicResource LxRule2Brush}" BorderThickness="0,0,0,1" Padding="16,0" Height="30">
              <Grid ColumnDefinitions="34,220,*,Auto,Auto,104,44" ColumnSpacing="12" Opacity="{Binding RowOpacity}">
                <TextBlock Classes="mono mute2 no m" Text="{Binding NumberText}" FontSize="11"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="mono b" FontSize="12.5" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding Prefix}" FontFamily="{StaticResource LxMono}" Foreground="{DynamicResource LxMute2Brush}" /><Run Text="{Binding Name}" />
                </TextBlock>
                <TextBlock Grid.Column="2" Text="{Binding Description}" FontSize="13" Opacity="0.78"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Text="{Binding Status}" Classes="mono mute m" FontSize="10.5"
                           VerticalAlignment="Center" MaxWidth="170" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding HasStatus}" ToolTip.Tip="{Binding UpdateHint}" />
                <TextBlock Grid.Column="4" Text="{Binding CostText}" Classes="mono m" FontSize="10.5" VerticalAlignment="Center"
                           IsVisible="{Binding HasCost}" ToolTip.Tip="Estimated tokens this skill takes in Claude's skill list" />
                <TextBlock Grid.Column="5" Text="{Binding SourceLabel}" Classes="mono" FontSize="11" Opacity="0.65"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Border Grid.Column="6" Classes="badge" IsVisible="{Binding HasMark}" MinWidth="40"
                        Classes.err="{Binding IsMarkError}" Classes.warn="{Binding IsMarkWarning}" Classes.quiet="{Binding IsMarkQuiet}"
                        ToolTip.Tip="{Binding Health.Text}">
                  <TextBlock Text="{Binding Mark}" HorizontalAlignment="Center" />
                </Border>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.DataTemplates>
      </ListBox>

      <ListBox x:Name="ProblemList" Grid.Row="1" Classes="rows" ItemsSource="{Binding VisibleProblems}"
               SelectedItem="{Binding SelectedProblem}" IsVisible="{Binding IsProblemsView}">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:ProblemItemViewModel">
            <Border BorderBrush="{DynamicResource LxRule2Brush}" BorderThickness="0,0,0,1" Padding="16,9">
              <Grid ColumnDefinitions="48,*" ColumnSpacing="12">
                <Border Classes="badge" Classes.err="{Binding IsError}" Classes.warn="{Binding IsWarning}"
                        VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="0,2,0,0">
                  <TextBlock Text="{Binding Badge}" HorizontalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock TextWrapping="Wrap">
                    <Run Text="{Binding Subject}" FontFamily="{StaticResource LxMonoBold}" FontSize="12.5" /><Run Text="   " /><Run Text="{Binding Message}" />
                  </TextBlock>
                  <TextBlock Text="{Binding Path}" Classes="mono mute" FontSize="11" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock Grid.Row="1" Text="NO MATCH." Classes="figure" FontFamily="{StaticResource LxCond}" FontSize="34"
                 Margin="16,40" IsVisible="{Binding IsEmptyResult}" />
      <TextBlock Grid.Row="1" Text="NO PROBLEMS." Classes="figure" FontFamily="{StaticResource LxCond}" FontSize="34"
                 Margin="16,40" IsVisible="{Binding HasNoProblems}" />
    </Grid>
  </Border>
</UserControl>
