<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:vm="using:Lustrum.App.ViewModels"
             x:Class="Lustrum.App.Views.SkillListPane"
             x:DataType="vm:MainViewModel">
  <Border Classes="panel">
    <Grid RowDefinitions="Auto,Auto,*">
      <Grid ColumnDefinitions="*,Auto,Auto" Margin="18,14,14,6">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{Binding ListTitle}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding VisibleSkills.Count}" Classes="tertiary" VerticalAlignment="Center" IsVisible="{Binding !IsProblemsView}" />
          <TextBlock Text="{Binding VisibleProblems.Count}" Classes="tertiary" VerticalAlignment="Center" IsVisible="{Binding IsProblemsView}" />
        </StackPanel>
        <ListBox Grid.Column="1" Classes="segments" Margin="0,0,12,0" VerticalAlignment="Center" SelectionMode="AlwaysSelected"
                 ItemsSource="{Binding ProjectViews}" SelectedItem="{Binding SelectedProjectView}"
                 IsVisible="{Binding CanChooseProjectView}">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:ProjectViewOption">
              <TextBlock Text="{Binding Title}" ToolTip.Tip="{Binding Hint}" FontSize="12" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <ComboBox Grid.Column="2" Classes="quiet" ItemsSource="{Binding Sorts}" SelectedItem="{Binding SelectedSort}"
                  MinWidth="140" FontSize="12" IsVisible="{Binding !IsProblemsView}">
          <ComboBox.ItemTemplate>
            <DataTemplate DataType="vm:SortOption">
              <TextBlock Text="{Binding Title}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </Grid>

      <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="16,0,14,6" IsVisible="{Binding !IsProblemsView}">
        <ItemsControl ItemsSource="{Binding Chips}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:ChipViewModel">
              <ToggleButton Classes="chip" Content="{Binding Label}" IsChecked="{Binding IsOn}" Margin="0,0,6,4"
                            IsEnabled="{Binding IsAvailable}" ToolTip.Tip="{Binding Hint}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <CheckBox Grid.Column="1" IsChecked="{Binding SearchInContent}" Content="Search SKILL.md text" FontSize="12"
                  VerticalAlignment="Top" ToolTip.Tip="Also match the text of each SKILL.md, not only names and descriptions" />
      </Grid>

      <ListBox x:Name="SkillList" Grid.Row="2" Classes="skills" ItemsSource="{Binding VisibleSkills}"
               SelectedItem="{Binding SelectedSkill}" IsVisible="{Binding !IsProblemsView}">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:SkillItemViewModel">
            <Grid ColumnDefinitions="Auto,232,*,Auto,Auto,Auto" ColumnSpacing="10" Height="34" Opacity="{Binding RowOpacity}">
              <fi:SymbolIcon Symbol="{Binding KindIcon}" FontSize="16" Foreground="{DynamicResource LxAccentBrush}" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding Prefix}" Foreground="{DynamicResource LxTextTertiaryBrush}" /><Run Text="{Binding Name}" FontWeight="SemiBold" />
              </TextBlock>
              <TextBlock Grid.Column="2" Text="{Binding Description}" Classes="secondary"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <Border Grid.Column="3" Classes="pill warning" IsVisible="{Binding HasAvailabilityLabel}" MaxWidth="170">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding AvailabilityLabel}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Border>
              <Border Grid.Column="4" Classes="pill" MaxWidth="160">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <fi:SymbolIcon Symbol="{Binding SourceIcon}" />
                  <TextBlock Text="{Binding SourceLabel}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Border>
              <Border Grid.Column="5" Classes="pill" Width="26" Padding="0,3" IsVisible="{Binding ShowHealth}"
                      Classes.error="{Binding Health.IsError}" Classes.warning="{Binding Health.IsWarning}"
                      ToolTip.Tip="{Binding Health.Text}">
                <StackPanel HorizontalAlignment="Center">
                  <fi:SymbolIcon Symbol="{Binding Health.Icon}" />
                </StackPanel>
              </Border>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <ListBox Grid.Row="2" Classes="skills" ItemsSource="{Binding VisibleProblems}"
               SelectedItem="{Binding SelectedProblem}" IsVisible="{Binding IsProblemsView}">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:ProblemItemViewModel">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,7">
              <Border Classes="pill" Width="28" Height="28" Padding="0" VerticalAlignment="Top"
                      Classes.error="{Binding IsError}" Classes.warning="{Binding IsWarning}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <fi:SymbolIcon Symbol="{Binding Icon}" />
                </StackPanel>
              </Border>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock>
                  <Run Text="{Binding Subject}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Message}" Foreground="{DynamicResource LxTextSecondaryBrush}" />
                </TextBlock>
                <TextBlock Text="{Binding Path}" Classes="mono tertiary" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                  IsVisible="{Binding IsEmptyResult}">
        <fi:SymbolIcon Symbol="SearchInfo" FontSize="34" Foreground="{DynamicResource LxTextTertiaryBrush}" />
        <TextBlock Text="Nothing found" Classes="secondary" HorizontalAlignment="Center" />
      </StackPanel>

      <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                  IsVisible="{Binding HasNoProblems}">
        <fi:SymbolIcon Symbol="CheckmarkCircle" FontSize="34" Foreground="{DynamicResource LxTextTertiaryBrush}" />
        <TextBlock Text="No problems found" Classes="secondary" HorizontalAlignment="Center" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
