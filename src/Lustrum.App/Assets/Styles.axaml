<Styles xmlns="https://github.com/avaloniaui"
        xmlns:fi="using:FluentIcons.Avalonia"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource LxSurfaceBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource LxTextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.tertiary">
    <Setter Property="Foreground" Value="{DynamicResource LxTextTertiaryBrush}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource LxMono}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource LxTextTertiaryBrush}" />
    <Setter Property="LetterSpacing" Value="0.6" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource LxPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LxBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>

  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="Background" Value="{DynamicResource LxNeutralBg}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.pill > StackPanel > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource LxNeutralFg}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.pill > StackPanel > fi|SymbolIcon">
    <Setter Property="Foreground" Value="{DynamicResource LxNeutralFg}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="Border.pill.ok"><Setter Property="Background" Value="{DynamicResource LxOkBg}" /></Style>
  <Style Selector="Border.pill.ok > StackPanel > TextBlock"><Setter Property="Foreground" Value="{DynamicResource LxOkFg}" /></Style>
  <Style Selector="Border.pill.ok > StackPanel > fi|SymbolIcon"><Setter Property="Foreground" Value="{DynamicResource LxOkFg}" /></Style>

  <Style Selector="Border.pill.warning"><Setter Property="Background" Value="{DynamicResource LxWarnBg}" /></Style>
  <Style Selector="Border.pill.warning > StackPanel > TextBlock"><Setter Property="Foreground" Value="{DynamicResource LxWarnFg}" /></Style>
  <Style Selector="Border.pill.warning > StackPanel > fi|SymbolIcon"><Setter Property="Foreground" Value="{DynamicResource LxWarnFg}" /></Style>

  <Style Selector="Border.pill.error"><Setter Property="Background" Value="{DynamicResource LxErrBg}" /></Style>
  <Style Selector="Border.pill.error > StackPanel > TextBlock"><Setter Property="Foreground" Value="{DynamicResource LxErrFg}" /></Style>
  <Style Selector="Border.pill.error > StackPanel > fi|SymbolIcon"><Setter Property="Foreground" Value="{DynamicResource LxErrFg}" /></Style>

  <Style Selector="Border.pill.skill"><Setter Property="Background" Value="{DynamicResource LxSkillBg}" /></Style>
  <Style Selector="Border.pill.skill > StackPanel > TextBlock"><Setter Property="Foreground" Value="{DynamicResource LxSkillFg}" /></Style>
  <Style Selector="Border.pill.skill > StackPanel > fi|SymbolIcon"><Setter Property="Foreground" Value="{DynamicResource LxSkillFg}" /></Style>

  <Style Selector="Border.pill.command"><Setter Property="Background" Value="{DynamicResource LxCommandBg}" /></Style>
  <Style Selector="Border.pill.command > StackPanel > TextBlock"><Setter Property="Foreground" Value="{DynamicResource LxCommandFg}" /></Style>
  <Style Selector="Border.pill.command > StackPanel > fi|SymbolIcon"><Setter Property="Foreground" Value="{DynamicResource LxCommandFg}" /></Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource LxBorderBrush}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Foreground" Value="{DynamicResource LxTextBrush}" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LxHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LxBorderBrush}" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource LxAccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LxAccentBrush}" />
    <Setter Property="Opacity" Value="0.88" />
  </Style>

  <Style Selector="ListBox.skills">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="6" />
  </Style>
  <Style Selector="ListBox.skills > ListBoxItem">
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ListBox.skills > ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LxHoverBrush}" />
  </Style>
  <Style Selector="ListBox.skills > ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LxSelectedBrush}" />
  </Style>
  <Style Selector="ListBox.skills > ListBoxItem:selected:focus /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LxSelectedBrush}" />
  </Style>

  <Style Selector="TreeView.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="6" />
  </Style>
  <Style Selector="TreeView.nav TreeViewItem">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="IsExpanded" Value="True" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="TreeView.nav TreeViewItem /template/ Border#PART_LayoutRoot:pointerover">
    <Setter Property="Background" Value="{DynamicResource LxHoverBrush}" />
  </Style>
  <Style Selector="TreeView.nav TreeViewItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource LxSelectedBrush}" />
  </Style>

  <Style Selector="ToggleButton.chip">
    <Setter Property="Background" Value="{DynamicResource LxNeutralBg}" />
    <Setter Property="Foreground" Value="{DynamicResource LxNeutralFg}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,2" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="ToggleButton.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LxHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LxTextBrush}" />
  </Style>
  <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LxSelectedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LxAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LxAccentBrush}" />
  </Style>

  <Style Selector="ListBox.segments">
    <Setter Property="Background" Value="{DynamicResource LxNeutralBg}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="2" />
  </Style>
  <Style Selector="ListBox.segments > ListBoxItem">
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ListBox.segments > ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LxPanelBrush}" />
  </Style>
  <Style Selector="ListBox.segments > ListBoxItem:selected TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource LxAccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ListBox.segments > ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LxHoverBrush}" />
  </Style>
  <Style Selector="ListBox.segments > ListBoxItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LxPanelBrush}" />
  </Style>

  <Style Selector="Border.diff">
    <Setter Property="Padding" Value="4,1" />
  </Style>
  <Style Selector="Border.diff.here"><Setter Property="Background" Value="{DynamicResource LxErrBg}" /></Style>
  <Style Selector="Border.diff.there"><Setter Property="Background" Value="{DynamicResource LxOkBg}" /></Style>
  <Style Selector="Border.diff.gap"><Setter Property="Background" Value="{DynamicResource LxNeutralBg}" /></Style>
  <Style Selector="Border.diff.gap TextBlock"><Setter Property="Foreground" Value="{DynamicResource LxTextTertiaryBrush}" /></Style>

  <Style Selector="TabControl.card > TabItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="12,6" />
  </Style>

  <Style Selector="ComboBox.quiet">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource LxBorderBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,4" />
  </Style>

  <Style Selector="TextBox.search">
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="4,8" />
    <Setter Property="Background" Value="{DynamicResource LxPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LxBorderBrush}" />
  </Style>

</Styles>
