<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource LxBgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LxInkBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource LxSans}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="TextBlock.mono, SelectableTextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource LxMono}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.mute, SelectableTextBlock.mute">
    <Setter Property="Foreground" Value="{DynamicResource LxMuteBrush}" />
  </Style>
  <Style Selector="TextBlock.mute2">
    <Setter Property="Foreground" Value="{DynamicResource LxMute2Brush}" />
  </Style>
  <Style Selector="TextBlock.mono.b, SelectableTextBlock.mono.b">
    <Setter Property="FontFamily" Value="{StaticResource LxMonoBold}" />
  </Style>
  <Style Selector="TextBlock.mono.m, SelectableTextBlock.mono.m">
    <Setter Property="FontFamily" Value="{StaticResource LxMonoMedium}" />
  </Style>
  <Style Selector="TextBlock.key">
    <Setter Property="FontFamily" Value="{StaticResource LxMonoBold}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource LxMuteBrush}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontFamily" Value="{StaticResource LxMonoBold}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="LetterSpacing" Value="0.8" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontFamily" Value="{StaticResource LxSemiBold}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LetterSpacing" Value="0.3" />
  </Style>
  <Style Selector="TextBlock.figure">
    <Setter Property="FontFamily" Value="{StaticResource LxXCond}" />
  </Style>
  <Style Selector="TextBlock.err">
    <Setter Property="Foreground" Value="{DynamicResource LxErrBrush}" />
  </Style>

  <Style Selector="Border.badge">
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.badge > TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource LxMonoBold}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{StaticResource LxOnLimeBrush}" />
  </Style>
  <Style Selector="Border.badge.err">
    <Setter Property="Background" Value="{DynamicResource LxErrBrush}" />
  </Style>
  <Style Selector="Border.badge.err > TextBlock">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Border.badge.warn">
    <Setter Property="Background" Value="{StaticResource LxWarnBrush}" />
  </Style>
  <Style Selector="Border.badge.lime">
    <Setter Property="Background" Value="{StaticResource LxLimeBrush}" />
  </Style>
  <Style Selector="Border.badge.quiet > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource LxInkBrush}" />
  </Style>

  <Style Selector="Button.cell">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource LxInkBrush}" />
  </Style>
  <Style Selector="Button.cell:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LxHlBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LxInkBrush}" />
  </Style>
  <Style Selector="Button.cell:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LxHlBrush}" />
  </Style>
  <Style Selector="Button.cell:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource LxDisBrush}" />
  </Style>
  <Style Selector="Button.cell:disabled TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource LxDisBrush}" />
  </Style>
  <Style Selector="Button.cell.inverse /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LxSelBgBrush}" />
  </Style>
  <Style Selector="Button.cell.inverse TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource LxSelFgBrush}" />
  </Style>
  <Style Selector="Button.cell.inverse TextBlock.key">
    <Setter Property="Foreground" Value="{DynamicResource LxSelNoBrush}" />
  </Style>
  <Style Selector="Button.cell.inverse:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LxSelHoverBrush}" />
  </Style>
  <Style Selector="Button.cell.on /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource LxLimeBrush}" />
  </Style>
  <Style Selector="Button.cell.on TextBlock">
    <Setter Property="Foreground" Value="{StaticResource LxOnLimeBrush}" />
  </Style>
  <Style Selector="Button.cell.soft:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LxLimeSoftBrush}" />
  </Style>
  <Style Selector="Button.cell.on.soft:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource LxLimeBrush}" />
  </Style>

  <Style Selector="Button.frame">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource LxRuleBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="FontFamily" Value="{StaticResource LxMonoBold}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource LxInkBrush}" />
  </Style>
  <Style Selector="Button.frame:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LxHlBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LxRuleBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LxInkBrush}" />
  </Style>
  <Style Selector="Button.frame:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource LxDisBdBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LxDisBrush}" />
  </Style>
  <Style Selector="Button.frame.solid /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LxSelBgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LxSelFgBrush}" />
  </Style>
  <Style Selector="Button.frame.solid:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LxSelHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LxSelFgBrush}" />
  </Style>
  <Style Selector="Button.frame.solid:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource LxDisBrush}" />
  </Style>

  <Style Selector="ToggleButton.chip">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource LxInkBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LxRuleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontFamily" Value="{StaticResource LxMonoMedium}" />
    <Setter Property="FontSize" Value="11.5" />
  </Style>
  <Style Selector="ToggleButton.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LxLimeSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LxInkBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LxRuleBrush}" />
  </Style>
  <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LxSelBgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LxSelNoBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LxSelBgBrush}" />
  </Style>
  <Style Selector="ToggleButton.chip:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource LxDisBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LxDisBdBrush}" />
  </Style>

  <Style Selector="ListBox.rows">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.rows > ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ListBox.rows > ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LxLimeSoftBrush}" />
  </Style>
  <Style Selector="ListBox.rows > ListBoxItem:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.rows > ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LxSelBgBrush}" />
  </Style>
  <Style Selector="ListBox.rows > ListBoxItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LxSelBgBrush}" />
  </Style>
  <Style Selector="ListBox.rows > ListBoxItem:selected:focus /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LxSelBgBrush}" />
  </Style>
  <Style Selector="ListBox.rows > ListBoxItem:selected TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource LxSelFgBrush}" />
  </Style>
  <Style Selector="ListBox.rows > ListBoxItem:selected TextBlock.no">
    <Setter Property="Foreground" Value="{DynamicResource LxSelNoBrush}" />
  </Style>
  <Style Selector="ListBox.rows > ListBoxItem:selected Border.badge > TextBlock">
    <Setter Property="Foreground" Value="{StaticResource LxOnLimeBrush}" />
  </Style>
  <Style Selector="ListBox.rows > ListBoxItem:selected Border.badge.err > TextBlock">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="ListBox.rows > ListBoxItem:selected Border.badge.quiet > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource LxSelFgBrush}" />
  </Style>

  <Style Selector="ListBox.segments">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.segments > ListBoxItem">
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderBrush" Value="{DynamicResource LxRuleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Margin" Value="0,0,-1,0" />
  </Style>
  <Style Selector="ListBox.segments > ListBoxItem TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource LxMonoBold}" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="ListBox.segments > ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LxLimeSoftBrush}" />
  </Style>
  <Style Selector="ListBox.segments > ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource LxLimeBrush}" />
  </Style>
  <Style Selector="ListBox.segments > ListBoxItem:selected TextBlock">
    <Setter Property="Foreground" Value="{StaticResource LxOnLimeBrush}" />
  </Style>

  <Style Selector="TabControl.lx">
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="TabControl.lx > TabItem">
    <Setter Property="FontFamily" Value="{StaticResource LxMonoBold}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="22,9,10,9" />
    <Setter Property="Foreground" Value="{DynamicResource LxMuteBrush}" />
  </Style>
  <Style Selector="TabControl.lx > TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource LxInkBrush}" />
  </Style>
  <Style Selector="TabControl.lx > TabItem:selected /template/ Border#PART_SelectedPipe">
    <Setter Property="Background" Value="{DynamicResource LxInkBrush}" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="TabControl.lx > TabItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource LxLimeSoftBrush}" />
  </Style>
  <Style Selector="TabControl.lx > TabItem:selected:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource LxLimeSoftBrush}" />
  </Style>

  <Style Selector="ComboBox.flat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource LxRuleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontFamily" Value="{StaticResource LxMono}" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <Style Selector="TextBox.search">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="{StaticResource LxSemiSemiBold}" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="Foreground" Value="{DynamicResource LxInkBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource LxInkBrush}" />
  </Style>
  <Style Selector="TextBox.search:pointerover /template/ Border#PART_BorderElement, TextBox.search:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.search /template/ TextBlock#PART_Watermark, TextBox.search /template/ TextBlock#PART_FloatingWatermark">
    <Setter Property="Foreground" Value="{DynamicResource LxMute2Brush}" />
  </Style>

  <Style Selector="Border.diff">
    <Setter Property="Padding" Value="4,1" />
  </Style>
  <Style Selector="Border.diff.here"><Setter Property="Background" Value="{DynamicResource LxErrBgBrush}" /></Style>
  <Style Selector="Border.diff.there"><Setter Property="Background" Value="{DynamicResource LxLimeSoftBrush}" /></Style>
  <Style Selector="Border.diff.gap"><Setter Property="Background" Value="{DynamicResource LxCodeBrush}" /></Style>
  <Style Selector="Border.diff.gap TextBlock"><Setter Property="Foreground" Value="{DynamicResource LxMuteBrush}" /></Style>

  <Style Selector="GridSplitter.rule">
    <Setter Property="Background" Value="{DynamicResource LxRuleBrush}" />
    <Setter Property="MinWidth" Value="1" />
    <Setter Property="Width" Value="1" />
  </Style>

  <Style Selector="Border.blink">
    <Style.Animations>
      <Animation Duration="0:0:1" IterationCount="Infinite">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="49%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

</Styles>
