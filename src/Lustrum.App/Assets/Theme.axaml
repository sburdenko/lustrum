<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Light">
      <Color x:Key="LxSurface">#F4F4F7</Color>
      <Color x:Key="LxPanel">#FFFFFF</Color>
      <Color x:Key="LxPanelAlt">#FAFAFC</Color>
      <Color x:Key="LxBorder">#E3E3EA</Color>
      <Color x:Key="LxText">#17171C</Color>
      <Color x:Key="LxTextSecondary">#5A5A68</Color>
      <Color x:Key="LxTextTertiary">#8E8E9C</Color>
      <Color x:Key="LxAccent">#4F46E5</Color>
      <Color x:Key="LxAccentSoft">#ECEEFF</Color>
      <Color x:Key="LxHover">#F0F0F5</Color>
      <Color x:Key="LxSelected">#E6E8FF</Color>
      <Color x:Key="LxCode">#F1F1F6</Color>
      <Color x:Key="LxOkFg">#13724A</Color>
      <Color x:Key="LxOkBg">#DDF5E8</Color>
      <Color x:Key="LxWarnFg">#8A5700</Color>
      <Color x:Key="LxWarnBg">#FFF0CC</Color>
      <Color x:Key="LxErrFg">#B3261E</Color>
      <Color x:Key="LxErrBg">#FDE3E1</Color>
      <Color x:Key="LxSkillFg">#4338CA</Color>
      <Color x:Key="LxSkillBg">#E9EAFE</Color>
      <Color x:Key="LxCommandFg">#0B7285</Color>
      <Color x:Key="LxCommandBg">#DDF4F8</Color>
      <Color x:Key="LxNeutralFg">#4B4B58</Color>
      <Color x:Key="LxNeutralBg">#ECECF1</Color>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <Color x:Key="LxSurface">#111114</Color>
      <Color x:Key="LxPanel">#1A1A1F</Color>
      <Color x:Key="LxPanelAlt">#16161A</Color>
      <Color x:Key="LxBorder">#2A2A33</Color>
      <Color x:Key="LxText">#F1F1F5</Color>
      <Color x:Key="LxTextSecondary">#A7A7B5</Color>
      <Color x:Key="LxTextTertiary">#767684</Color>
      <Color x:Key="LxAccent">#8D95FF</Color>
      <Color x:Key="LxAccentSoft">#23264A</Color>
      <Color x:Key="LxHover">#24242B</Color>
      <Color x:Key="LxSelected">#2B3063</Color>
      <Color x:Key="LxCode">#222228</Color>
      <Color x:Key="LxOkFg">#7BE0A6</Color>
      <Color x:Key="LxOkBg">#173A2A</Color>
      <Color x:Key="LxWarnFg">#FFD479</Color>
      <Color x:Key="LxWarnBg">#43330F</Color>
      <Color x:Key="LxErrFg">#FFA7A0</Color>
      <Color x:Key="LxErrBg">#4A1D1A</Color>
      <Color x:Key="LxSkillFg">#B4BAFF</Color>
      <Color x:Key="LxSkillBg">#272B57</Color>
      <Color x:Key="LxCommandFg">#7FDCEB</Color>
      <Color x:Key="LxCommandBg">#12353C</Color>
      <Color x:Key="LxNeutralFg">#BEBECB</Color>
      <Color x:Key="LxNeutralBg">#2C2C35</Color>
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <SolidColorBrush x:Key="LxSurfaceBrush" Color="{DynamicResource LxSurface}" />
  <SolidColorBrush x:Key="LxPanelBrush" Color="{DynamicResource LxPanel}" />
  <SolidColorBrush x:Key="LxPanelAltBrush" Color="{DynamicResource LxPanelAlt}" />
  <SolidColorBrush x:Key="LxBorderBrush" Color="{DynamicResource LxBorder}" />
  <SolidColorBrush x:Key="LxTextBrush" Color="{DynamicResource LxText}" />
  <SolidColorBrush x:Key="LxTextSecondaryBrush" Color="{DynamicResource LxTextSecondary}" />
  <SolidColorBrush x:Key="LxTextTertiaryBrush" Color="{DynamicResource LxTextTertiary}" />
  <SolidColorBrush x:Key="LxAccentBrush" Color="{DynamicResource LxAccent}" />
  <SolidColorBrush x:Key="LxAccentSoftBrush" Color="{DynamicResource LxAccentSoft}" />
  <SolidColorBrush x:Key="LxHoverBrush" Color="{DynamicResource LxHover}" />
  <SolidColorBrush x:Key="LxSelectedBrush" Color="{DynamicResource LxSelected}" />
  <SolidColorBrush x:Key="LxCodeBrush" Color="{DynamicResource LxCode}" />
  <SolidColorBrush x:Key="LxErrFgBrush" Color="{DynamicResource LxErrFg}" />
  <SolidColorBrush x:Key="LxWarnFgBrush" Color="{DynamicResource LxWarnFg}" />

  <FontFamily x:Key="LxMono">Menlo,SF Mono,Cascadia Mono,Consolas,DejaVu Sans Mono,monospace</FontFamily>

</ResourceDictionary>
